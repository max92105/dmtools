<Page x:Class="DMTools.Pages.LootGeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1280"
      Loaded="Page_Loaded" Title="Loot Generator"
      Background="#F2080000">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- ── Scrollbar ── -->
        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Height="0" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#77E69A28" CornerRadius="2" Margin="1,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Height="0" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>

        <!-- ── Text ── -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#99E69A28"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="#F5E6D3"/>
            <Setter Property="BorderBrush" Value="#77E69A28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#E69A28"/>
            <Setter Property="SelectionBrush" Value="#66E69A28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Buttons ── -->
        <Style x:Key="AmberBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFE69A28"/>
            <Setter Property="Background" Value="#66E69A28"/>
            <Setter Property="BorderBrush" Value="#AAE69A28"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource AmberBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#55E69A28"/>
            <Setter Property="Foreground" Value="#CCE6D3B8"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource AmberBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#66CC4433"/>
            <Setter Property="Foreground" Value="#CCDD7766"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#99E6D3B8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55CC4433"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode tabs (ITEMS / LOOT TABLES) -->
        <Style x:Key="ModeBtn" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#88E69A28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#44E69A28" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22E69A28"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55E69A28"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAE69A28"/>
                                <Setter Property="Foreground" Value="#FFE69A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rarity filter chips -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#AAE6D3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="#14FFFFFF" BorderBrush="#33E69A28" BorderThickness="1" CornerRadius="10" Padding="9,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#88E69A28"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55E69A28"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#CCE69A28"/>
                                <Setter Property="Foreground" Value="#FFF5E6D3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox with label -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCE6D3B8"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="bd" Width="14" Height="14" VerticalAlignment="Center"
                                    Background="#22FFFFFF" BorderBrush="#66E69A28" BorderThickness="1" CornerRadius="2">
                                <TextBlock x:Name="check" Text="✓" FontSize="11" Foreground="#FFE69A28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Background" Value="#44E69A28"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAE69A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Combo ── -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F0E6D3"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#44FFFFFF" BorderBrush="#77E69A28" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0"/>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="#AAE69A28" FontSize="11"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAE69A28"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom">
                                <Border Background="#F30A0000" BorderBrush="#88E69A28" BorderThickness="1" CornerRadius="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F0E6D3"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#33E69A28"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#55E69A28"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Lists ── -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#18E69A28" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22E69A28"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44E69A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F0E6D3"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}"/>
        </Style>

        <!-- Rarity name → colour -->
        <Style x:Key="RarityText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#99E6D3B8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Rarity}" Value="Common"><Setter Property="Foreground" Value="#D8D0C4"/></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Uncommon"><Setter Property="Foreground" Value="#6CC25A"/></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Rare"><Setter Property="Foreground" Value="#5C9BE6"/></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Very Rare"><Setter Property="Foreground" Value="#B07AE6"/></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Legendary"><Setter Property="Foreground" Value="#F0A030"/></DataTrigger>
                <DataTrigger Binding="{Binding Rarity}" Value="Artifact"><Setter Property="Foreground" Value="#E0604C"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Background="#F50A0000" BorderBrush="#55E69A28" BorderThickness="0,0,0,1">
            <Grid Margin="24,0,24,0">
                <TextBlock Text="Loot Generator" FontFamily="Georgia" FontSize="24" FontStyle="Italic"
                           Foreground="#FFE69A28" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="tbItemsMode" Content="ITEMS" Style="{StaticResource ModeBtn}"
                                  IsChecked="True" Click="tbItemsMode_Click"/>
                    <ToggleButton x:Name="tbTablesMode" Content="LOOT TABLES" Style="{StaticResource ModeBtn}"
                                  Margin="-1,0,0,0" Click="tbTablesMode_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Left: filters (items) / tables (loot tables) ══ -->
            <Border Grid.Column="0" Background="#F80A0000" BorderBrush="#55E69A28" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Item filters -->
                    <ScrollViewer x:Name="panelFilters" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <TextBlock Text="SEARCH" Style="{StaticResource Lbl}"/>
                            <TextBox x:Name="txtSearch" Style="{StaticResource DarkInput}" Margin="0,0,0,14"
                                     TextChanged="Filter_Changed" ToolTip="Name or text in the description"/>

                            <TextBlock Text="RARITY" Style="{StaticResource Lbl}" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="wpRarity" Margin="0,0,0,10"/>

                            <TextBlock Text="CATEGORY" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cmbCategory" Style="{StaticResource DarkCombo}" Margin="0,0,0,14"
                                      SelectionChanged="Filter_Changed"/>

                            <TextBlock Text="ATTUNEMENT" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cmbAttunement" Style="{StaticResource DarkCombo}" Margin="0,0,0,14"
                                      SelectionChanged="Filter_Changed"/>

                            <TextBlock Text="SOURCE" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cmbSource" Style="{StaticResource DarkCombo}" Margin="0,0,0,14"
                                      SelectionChanged="Filter_Changed"/>

                            <CheckBox x:Name="chkMagicOnly" Content="Magic items only" IsChecked="True"
                                      Style="{StaticResource DarkCheck}" Margin="0,0,0,16"
                                      Click="Filter_Changed"/>

                            <Button Content="Clear Filters" Style="{StaticResource GhostBtn}"
                                    HorizontalAlignment="Stretch" Click="btnClearFilters_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Loot tables -->
                    <Grid x:Name="panelTables" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="LOOT TABLES" Style="{StaticResource Lbl}" Margin="14,14,14,6"/>
                        <ListBox x:Name="lbTables" Grid.Row="1" Style="{StaticResource DarkList}"
                                 SelectionChanged="lbTables_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#F5E6D3" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Source, StringFormat='{}{0} table'}" FontSize="10" FontStyle="Italic"
                                                   Foreground="#77E69A28">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Source}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="2" BorderBrush="#44E69A28" BorderThickness="0,1,0,0" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="NAME" Style="{StaticResource Lbl}"/>
                                <TextBox x:Name="txtTableName" Style="{StaticResource DarkInput}" Margin="0,0,0,10"
                                         LostFocus="txtTableName_LostFocus" KeyDown="txtTableName_KeyDown"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="+ New Table" Style="{StaticResource AmberBtn}" Click="btnNewTable_Click"/>
                                    <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerBtn}" Click="btnDeleteTable_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ Center: item list / table entries ══ -->
            <Grid Grid.Column="1">
                <!-- Items -->
                <Grid x:Name="panelItems">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F50A0000" BorderBrush="#33E69A28" BorderThickness="0,0,0,1" Padding="16,10">
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="tbItemCount" DockPanel.Dock="Left" FontFamily="Georgia" FontSize="12" FontStyle="Italic"
                                       Foreground="#88E69A28" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="⚄ Roll random" Style="{StaticResource AmberBtn}"
                                    ToolTip="Pick random items among the ones listed" Click="btnRollFromFilter_Click"/>
                            <TextBox x:Name="txtFilterRollCount" DockPanel.Dock="Right" Text="3" Width="44" TextAlignment="Center"
                                     Style="{StaticResource DarkInput}" Margin="0,0,6,0" ToolTip="How many items"/>
                            <Button DockPanel.Dock="Right" Content="+ New Item" Style="{StaticResource GhostBtn}"
                                    Margin="0,0,16,0" ToolTip="Create your own item" Click="btnNewItem_Click"/>
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="lbItems" Grid.Row="1" Style="{StaticResource DarkList}"
                             SelectionChanged="lbItems_SelectionChanged" MouseDoubleClick="lbItems_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#F5E6D3"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Rarity}" Style="{StaticResource RarityText}"/>
                                            <TextBlock Text="{Binding Category, StringFormat=' · {0}'}" FontSize="11" Foreground="#99E6D3B8"/>
                                            <TextBlock Text=" · attunement" FontSize="11" FontStyle="Italic" Foreground="#99E69A28"
                                                       Visibility="{Binding RequiresAttunement, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{Binding Source, StringFormat=' · {0}'}" FontSize="10" FontStyle="Italic" Foreground="#55E6D3B8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ValueGp, StringFormat='{}{0:#,0.##} gp', TargetNullValue=''}" FontSize="12"
                                               Foreground="#AAE69A28" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Table entries -->
                <Grid x:Name="panelEntries" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F50A0000" BorderBrush="#33E69A28" BorderThickness="0,0,0,1" Padding="16,10">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="⚄ Roll" Style="{StaticResource AmberBtn}" Click="btnRollTable_Click"/>
                            <TextBox x:Name="txtTableRollCount" DockPanel.Dock="Right" Text="1" Width="44" TextAlignment="Center"
                                     Style="{StaticResource DarkInput}" Margin="0,0,6,0" ToolTip="How many rolls on the table"/>
                            <TextBlock DockPanel.Dock="Right" Text="ROLLS" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="tbTableTitle" FontFamily="Georgia" FontSize="15" FontStyle="Italic"
                                           Foreground="#FFE69A28" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="tbTableDescription" FontFamily="Georgia" FontSize="10" FontStyle="Italic"
                                           Foreground="#77E6D3B8" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Column headers -->
                    <Grid Grid.Row="1" Margin="12,8,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ENTRY" Style="{StaticResource Lbl}"/>
                        <TextBlock Grid.Column="1" Text="WEIGHT" Style="{StaticResource Lbl}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="QUANTITY" Style="{StaticResource Lbl}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="CHANCE" Style="{StaticResource Lbl}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ListBox x:Name="lbEntries" Grid.Row="2" Style="{StaticResource DarkList}"
                             SelectionChanged="lbEntries_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="Padding" Value="12,4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#F5E6D3" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Rarity}" Style="{StaticResource RarityText}" FontSize="10"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding Weight, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkInput}"
                                             TextAlignment="Center" Margin="4,0" Padding="2,3" LostFocus="EntryField_LostFocus"/>
                                    <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkInput}"
                                             TextAlignment="Center" Margin="4,0" Padding="2,3" LostFocus="EntryField_LostFocus"
                                             ToolTip="A number or dice: 1, 2, 1d4, 2d6+1"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ChanceText}" FontSize="11" Foreground="#AAE69A28"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource IconBtn}" Tag="{Binding}"
                                            ToolTip="Remove from table" Click="btnRemoveEntry_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Add a name-only entry -->
                    <Border Grid.Row="3" Background="#F50A0000" BorderBrush="#33E69A28" BorderThickness="0,1,0,0" Padding="16,10">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="+ Add" Style="{StaticResource GhostBtn}" Click="btnAddTextEntry_Click"/>
                            <Grid Margin="0,0,8,0">
                                <TextBox x:Name="txtNewEntry" Style="{StaticResource DarkInput}"
                                         KeyDown="txtNewEntry_KeyDown"
                                         ToolTip="Add an entry that is not in the item list (e.g. '150 gp', 'Weapon +1')"/>
                                <TextBlock Text="Add an entry by name — e.g. 150 gp, Weapon +1, Potion of Healing (or double-click an item in ITEMS)"
                                           IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontFamily="Georgia" FontSize="11" FontStyle="Italic" Foreground="#55E6D3B8"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtNewEntry}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ══ Right: details + results ══ -->
            <Border Grid.Column="2" Background="#F80A0000" BorderBrush="#55E69A28" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                    </Grid.RowDefinitions>

                    <!-- Item details -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,14">
                                <TextBlock x:Name="tbDetailsEmpty" Text="Select an item to see its details."
                                           FontFamily="Georgia" FontSize="12" FontStyle="Italic" Foreground="#66E6D3B8"/>
                                <StackPanel x:Name="pnlDetails" Visibility="Collapsed">
                                    <TextBlock x:Name="tbDetailName" FontFamily="Georgia" FontSize="18" FontStyle="Italic"
                                               Foreground="#FFE69A28" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="tbDetailRarity" Style="{StaticResource RarityText}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="tbDetailMeta" FontFamily="Georgia" FontSize="11" Foreground="#99E6D3B8"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="✎ Edit" Style="{StaticResource GhostBtn}" FontSize="11" Padding="10,3"
                                                Margin="0,0,6,0" Click="btnEditItem_Click"/>
                                        <Button Content="Delete" Style="{StaticResource DangerBtn}" FontSize="11" Padding="10,3"
                                                Click="btnDeleteItem_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="tbDetailProperties" FontFamily="Georgia" FontSize="12" Foreground="#CCE69A28"
                                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <Border Height="1" Background="#33E69A28" Margin="0,10,0,10"/>
                                    <TextBox x:Name="tbDetailDescription" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="Georgia" FontSize="12" Foreground="#E6DCCB" TextWrapping="Wrap"
                                             SelectionBrush="#66E69A28"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Add the selected item to a table -->
                        <Border x:Name="pnlAddToTable" Grid.Row="1" Visibility="Collapsed"
                                BorderBrush="#33E69A28" BorderThickness="0,1,0,0" Padding="16,10">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="+ Add" Style="{StaticResource AmberBtn}" Click="btnAddToTable_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="ADD TO" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="cmbAddToTable" Style="{StaticResource DarkCombo}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#44E69A28"
                                  ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>

                    <!-- Rolled loot -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="16,10,16,6" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="ROLLED LOOT" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostBtn}" FontSize="10" Padding="8,3"
                                    Click="btnClearResults_Click"/>
                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource GhostBtn}" FontSize="10" Padding="8,3"
                                    Margin="0,0,6,0" ToolTip="Copy the list as text" Click="btnCopyResults_Click"/>
                        </DockPanel>
                        <ListBox x:Name="lbResults" Grid.Row="1" Style="{StaticResource DarkList}"
                                 SelectionChanged="lbResults_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding QuantityText}" FontSize="13" FontWeight="Bold"
                                                   Foreground="#FFE69A28" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#F5E6D3" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Rarity}" Style="{StaticResource RarityText}" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" Foreground="#AAE69A28"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="tbResultsTotal" Grid.Row="2" Margin="16,6,16,10" FontFamily="Georgia" FontSize="11"
                                   FontStyle="Italic" Foreground="#88E69A28"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
