<h:DarkWindow x:Class="DMTools.Pages.ItemEditWindow" xmlns:h="clr-namespace:DMTools.Helpers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item" Width="780" Height="680" MinWidth="520" MinHeight="380"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#F2080000">
    <h:DarkWindow.Resources>

        <Style x:Key="SlimScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Height="0" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#77E69A28" CornerRadius="2" Margin="1,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Height="0" Opacity="0" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScroll}"/>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#99E69A28"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="#F5E6D3"/>
            <Setter Property="BorderBrush" Value="#77E69A28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#E69A28"/>
            <Setter Property="SelectionBrush" Value="#66E69A28"/>
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5E6D3"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33E69A28"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55E69A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable combo: pick a value or type a new one -->
        <Style x:Key="DarkEditCombo" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="bd" Background="#44FFFFFF" BorderBrush="#77E69A28" BorderThickness="1" MinHeight="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Background="Transparent" Foreground="#F5E6D3"
                                         BorderThickness="0" FontFamily="Georgia" FontSize="12" Padding="8,0" VerticalAlignment="Center"
                                         CaretBrush="#E69A28" SelectionBrush="#66E69A28"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"/>
                                <ToggleButton Grid.Column="1" Cursor="Hand"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock Text="▾" Foreground="#88E69A28" FontSize="10"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" AllowsTransparency="True"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="#F0120000" BorderBrush="#88E69A28" BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fixed list combo -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#44FFFFFF" BorderBrush="#77E69A28" BorderThickness="1" MinHeight="32">
                                            <TextBlock Text="▾" Foreground="#88E69A28" FontSize="10" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="9,0,28,0"
                                              VerticalAlignment="Center" TextBlock.Foreground="#F5E6D3"
                                              TextBlock.FontFamily="Georgia" TextBlock.FontSize="12"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#F0120000" BorderBrush="#88E69A28" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCE6D3B8"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="bd" Width="14" Height="14" VerticalAlignment="Center"
                                    Background="#22FFFFFF" BorderBrush="#66E69A28" BorderThickness="1" CornerRadius="2">
                                <TextBlock x:Name="check" Text="✓" FontSize="11" Foreground="#FFE69A28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Background" Value="#44E69A28"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#AAE69A28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmberBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFE69A28"/>
            <Setter Property="Background" Value="#66E69A28"/>
            <Setter Property="BorderBrush" Value="#AAE69A28"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource AmberBtn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#55E69A28"/>
            <Setter Property="Foreground" Value="#CCE6D3B8"/>
        </Style>
    </h:DarkWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#F50A0000" BorderBrush="#55E69A28" BorderThickness="0,0,0,1" Padding="20,12">
            <TextBlock x:Name="tbHeader" Text="Item" FontFamily="Georgia" FontSize="20" FontStyle="Italic" Foreground="#FFE69A28"/>
        </Border>

        <!-- Content: scrolls on small screens, the description fills the free space otherwise -->
        <ScrollViewer x:Name="svContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,14,16,10">
            <Grid MinHeight="460" Height="{Binding ViewportHeight, ElementName=svContent}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Name -->
                    <TextBlock Text="NAME" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="txtName" Style="{StaticResource DarkInput}" Margin="0,0,0,12"/>

                    <!-- Category / Rarity / Source -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CATEGORY" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cboCategory" Style="{StaticResource DarkEditCombo}"
                                      ToolTip="Pick a category or type a new one"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RARITY" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cboRarity" Style="{StaticResource DarkCombo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SOURCE" Style="{StaticResource Lbl}"/>
                            <ComboBox x:Name="cboSource" Style="{StaticResource DarkEditCombo}"
                                      ToolTip="Book code (DMG, XGE...) or anything you like, e.g. Homebrew"/>
                        </StackPanel>
                    </Grid>

                    <!-- Value / Weight / Attunement -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VALUE (GP)" Style="{StaticResource Lbl}"/>
                            <TextBox x:Name="txtValue" Style="{StaticResource DarkInput}" ToolTip="Leave empty if unknown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="WEIGHT (LB)" Style="{StaticResource Lbl}"/>
                            <TextBox x:Name="txtWeight" Style="{StaticResource DarkInput}" ToolTip="Leave empty if unknown"/>
                        </StackPanel>
                        <CheckBox x:Name="chkAttunement" Grid.Column="4" Content="Requires attunement"
                                  Style="{StaticResource DarkCheck}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        <StackPanel Grid.Column="6" IsEnabled="{Binding IsChecked, ElementName=chkAttunement}">
                            <TextBlock Text="ATTUNEMENT RESTRICTION" Style="{StaticResource Lbl}"/>
                            <TextBox x:Name="txtAttunementNote" Style="{StaticResource DarkInput}"
                                     ToolTip="Optional, e.g. 'by a wizard' or 'by a creature of good alignment'"/>
                        </StackPanel>
                    </Grid>

                    <!-- Properties -->
                    <TextBlock Text="PROPERTIES  (damage, AC, charges... — optional)" Style="{StaticResource Lbl}"/>
                    <TextBox x:Name="txtProperties" Style="{StaticResource DarkInput}" Margin="0,0,0,12"/>

                    <TextBlock Text="DESCRIPTION" Style="{StaticResource Lbl}"/>
                </StackPanel>

                <TextBox x:Name="txtDescription" Grid.Row="1" Style="{StaticResource DarkInput}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,6"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F50A0000" BorderBrush="#33E69A28" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="btnCancel_Click"/>
                <Button Content="Save" Style="{StaticResource AmberBtn}" Click="btnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</h:DarkWindow>
